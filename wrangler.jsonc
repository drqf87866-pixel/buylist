{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "buylist",
	"main": "src/index.ts",
	"compatibility_date": "2026-08-01",
	"assets": {
		"directory": "./public",
		"binding": "ASSETS",
		"not_found_handling": "single-page-application",
		"run_worker_first": [
			"/api/*"
		]
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "buylist-db",
			"database_id": "92f528f7-ae69-481d-b3bc-80b20bcaa76f"
		},
		{
			"binding": "buylist_db",
			"database_name": "buylist-db",
			"database_id": "92f528f7-ae69-481d-b3bc-80b20bcaa76f"
		}
	],
	"durable_objects": {
		"bindings": [
			{
				"name": "SHOPPING_LIST_DO",
				"class_name": "ShoppingListDO"
			}
		]
	},
	"migrations": [
		{
			"tag": "v1",
			"new_sqlite_classes": [
				"ShoppingListDO"
			]
		}
	]
}